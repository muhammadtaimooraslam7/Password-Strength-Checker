"""
DecodeLabs Cyber Security Industrial Training Kit — Project 1
Password Strength Checker

Goal: Classify a password as Weak, Medium, or Strong based on:
  - Length
  - Use of uppercase letters
  - Use of digits
  - Use of special symbols
Bonus: Flags common/leaked passwords.
"""

import string

# A tiny sample of commonly leaked/weak passwords (extend as needed)
COMMON_PASSWORDS = {
    "password", "123456", "123456789", "qwerty", "abc123",
    "password1", "111111", "12345678", "letmein", "iloveyou"
}


def check_password_strength(password: str) -> dict:
    """
    Analyzes a password and returns a dict with score, rating, and feedback.
    """
    length = len(password)
    has_upper = any(char.isupper() for char in password)
    has_lower = any(char.islower() for char in password)
    has_digit = any(char.isdigit() for char in password)
    has_symbol = any(char in string.punctuation for char in password)
    is_common = password.lower() in COMMON_PASSWORDS

    feedback = []
    score = 0

    # --- Length checks ---
    if length < 8:
        feedback.append("Too short (minimum 8 characters recommended).")
    elif length < 12:
        score += 1
        feedback.append("Decent length, but 12+ characters is stronger.")
    else:
        score += 2

    # --- Character variety checks ---
    if has_upper:
        score += 1
    else:
        feedback.append("Add at least one uppercase letter.")

    if has_lower:
        score += 1
    else:
        feedback.append("Add at least one lowercase letter.")

    if has_digit:
        score += 1
    else:
        feedback.append("Add at least one number.")

    if has_symbol:
        score += 1
    else:
        feedback.append("Add at least one special symbol (e.g. !, @, #, $).")

    # --- Common password check ---
    if is_common:
        score = 0
        feedback = ["This password appears in common leaked password lists. Choose a different one."]

    # --- Determine rating ---
    if score <= 2:
        rating = "Weak"
    elif score <= 4:
        rating = "Medium"
    else:
        rating = "Strong"

    return {
        "password": password,
        "length": length,
        "score": score,
        "rating": rating,
        "feedback": feedback,
    }


def display_result(result: dict) -> None:
    print("\n--- Password Strength Report ---")
    print(f"Password Length : {result['length']}")
    print(f"Score           : {result['score']} / 6")
    print(f"Strength Rating : {result['rating']}")
    if result["feedback"]:
        print("Suggestions:")
        for tip in result["feedback"]:
            print(f"  - {tip}")
    print("---------------------------------\n")


def main():
    print("=== DecodeLabs Password Strength Checker ===")
    while True:
        pwd = input("Enter a password to check (or 'q' to quit): ")
        if pwd.lower() == "q":
            print("Exiting. Stay secure!")
            break
        result = check_password_strength(pwd)
        display_result(result)


if __name__ == "__main__":
    main()